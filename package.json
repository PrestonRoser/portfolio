{
  "name": "portfolio",
  "type": "module",
  "version": "0.0.1",
  "description": "Personal site for Preston Roser.",
  "author": "Preston Roser",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "astro": "astro",
    "tokens": "node scripts/tokens.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "predev": "node scripts/fetch-fonts.mjs && node scripts/github-snapshot.mjs",
    "prebuild": "node scripts/fetch-fonts.mjs && node scripts/github-snapshot.mjs",
    "test": "node --test worker/*.test.js",
    "postbuild": "node scripts/security-headers.mjs && node scripts/scan-dist.mjs",
    "og": "node scripts/og-image.mjs",
    "previews": "node scripts/previews.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.0.1",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "leaflet": "^1.9.4",
    "svelte": "^5.57.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@catppuccin/palette": "^1.8.0",
    "@types/leaflet": "^1.9.22",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "prettier-plugin-svelte": "^4.1.1",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "wrangler": "^4.131.1"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
