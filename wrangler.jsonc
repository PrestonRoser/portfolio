{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-12",
  // Only reachable through the custom domains below, so the zone's rate limit and
  // security rules always apply. Both settings are inherited by the qa env.
  "workers_dev": false,
  "observability": { "enabled": true },
  "routes": [{ "pattern": "prestonroser.dev", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Everything except /api is served straight from dist/ without running the Worker.
    "run_worker_first": ["/api/*"],
  },
  // GITHUB_TOKEN is a secret, set per environment:
  //   npx wrangler secret put GITHUB_TOKEN --env=""
  //   npx wrangler secret put GITHUB_TOKEN --env qa
  "env": {
    // Staging. Deployed from the qa branch as a separate Worker, portfolio-qa.
    "qa": {
      "routes": [{ "pattern": "qa.prestonroser.dev", "custom_domain": true }],
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        "run_worker_first": ["/api/*"],
      },
    },
  },
}
