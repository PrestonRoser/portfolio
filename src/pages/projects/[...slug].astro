---
import { render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import ProjectPreview from "../../components/ProjectPreview.astro";
import { getProjects } from "../../lib/content";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, tags, context, period, repo, url } = project.data;
const previewHref = url ?? repo;
---

<Layout title={title} description={summary}>
  <article class="project-layout pt-12 sm:pt-16">
    <header>
      <p class="font-code text-small text-subtext0">
        {context} · {period}
      </p>
      <h1 class="t-display mt-2 text-h1">{title}</h1>
      <p class="mt-3 text-lead text-subtext1">{summary}</p>
      <p class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-small">
        {tags.map((tag) => (
          <span class="tag">{tag}</span>
        ))}
        {repo && (
          <a class="link" href={repo} target="_blank" rel="noopener noreferrer">
            Source
          </a>
        )}
        {url && (
          <a class="link" href={url} target="_blank" rel="noopener noreferrer">
            Live site
          </a>
        )}
      </p>
    </header>
    <div class="prose">
      <Content />
    </div>
    {previewHref && (
      <aside class="lg:sticky lg:top-8 lg:self-start" aria-label="Site preview">
        <ProjectPreview slug={project.id} title={title} href={previewHref} />
      </aside>
    )}
  </article>
  <p class="mt-12">
    <a class="link text-small" href="/projects">
      All projects
    </a>
  </p>
</Layout>
