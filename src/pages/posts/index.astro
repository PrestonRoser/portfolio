---
import Layout from "../../layouts/Layout.astro";
import PostList from "../../components/PostList.astro";
import { site } from "../../data/site";
---

<Layout title="Posts" description="Recent posts from LinkedIn on building HANDS and studying CS.">
  <div class="mx-auto max-w-3xl">
    <div class="flex flex-wrap items-baseline justify-between gap-4 pt-12 sm:pt-16">
      <h1 class="t-display text-h1">Posts</h1>
      <a
        class="link text-small"
        href={site.links.linkedin}
        target="_blank"
        rel="noopener noreferrer"
      >
        Follow on LinkedIn
      </a>
    </div>
    <p class="mt-3 max-w-[60ch] text-subtext1">
      I post on LinkedIn about building HANDS, studying CS and what I'm learning along the way.
    </p>
    <div class="tile mt-8">
      <PostList excerpts />
    </div>
  </div>
</Layout>
