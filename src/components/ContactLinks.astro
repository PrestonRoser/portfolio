---
import Icon from "./Icon.astro";
import { site } from "../data/site";
---

<div class="grid gap-3 sm:grid-cols-3">
  <a class="contact-tile" href={`mailto:${site.email}`}>
    <span class="text-accent-ink">
      <Icon name="mail" size={20} />
    </span>
    <span class="font-semibold">Email</span>
    <span class="font-code text-[0.75rem] text-subtext0">{site.email}</span>
  </a>
  <a class="contact-tile" href={site.links.github} target="_blank" rel="noopener noreferrer">
    <span class="text-accent-ink">
      <Icon name="github" size={20} />
    </span>
    <span class="font-semibold">GitHub</span>
    <span class="font-code text-[0.75rem] text-subtext0">@PrestonRoser</span>
  </a>
  <a class="contact-tile" href={site.links.linkedin} target="_blank" rel="noopener noreferrer">
    <span class="text-accent-ink">
      <Icon name="linkedin" size={20} />
    </span>
    <span class="font-semibold">LinkedIn</span>
    <span class="font-code text-[0.75rem] text-subtext0">in/prestonroser</span>
  </a>
</div>
