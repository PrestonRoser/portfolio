---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

interface Props {
  project: CollectionEntry<"projects">;
  heading?: "h2" | "h3";
  class?: string;
}

// A cover image is picked up by file name, so src/assets/projects/sqaas.webp
// belongs to src/content/projects/sqaas.mdx. Projects without one get no cover.
const covers = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/projects/*.{avif,webp,png,jpg,jpeg}",
  { eager: true },
);

const { project, heading: Heading = "h3", class: className } = Astro.props;
const { title, summary, tags, context, period } = project.data;
const href = `/projects/${project.id}`;
const cover = Object.entries(covers).find(
  ([path]) =>
    path
      .split("/")
      .pop()
      ?.replace(/\.\w+$/, "") === project.id,
)?.[1].default;
---

<article class:list={["tile group flex flex-col gap-4", className]}>
  {cover && (
    <a class="cover" href={href} tabindex="-1" aria-hidden="true">
      <Image
        src={cover}
        alt=""
        widths={[480, 720, 1080]}
        sizes="(min-width: 48rem) 36rem, 100vw"
        class="absolute inset-0 size-full object-cover"
      />
    </a>
  )}
  <div>
    <Heading class="text-h3 font-semibold">
      <a class="transition-colors hover:text-accent-ink" href={href}>
        {title}
      </a>
    </Heading>
    <p class="mt-1 font-code text-[0.75rem] text-subtext0">
      {context} · {period}
    </p>
  </div>
  <p class="text-small text-subtext1">{summary}</p>
  <p class="mt-auto flex flex-wrap gap-1.5">
    {tags.map((tag) => (
      <span class="tag">{tag}</span>
    ))}
  </p>
</article>
